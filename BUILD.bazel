package(default_visibility = ["//visibility:public"])

cc_library(
    name = "fdt",
    srcs = [
        "fdt.c",
        "fdt_addresses.c",
        "fdt_empty_tree.c",
        "fdt_ro.c",
        "fdt_rw.c",
        "fdt_strerror.c",
        "fdt_sw.c",
        "fdt_wip.c",
        "libfdt_internal.h",
    ],
    hdrs = glob(["include/**/*"]),
    includes = ["include"],
    deps = [
        "@zircon//:system_headers",
    ],
    alwayslink = True,
    visibility = [
        "//visibility:public",
    ],
)
